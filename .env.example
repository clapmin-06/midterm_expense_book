DATABASE_URL=

# --- 구글 로그인 (배포/실사용) ---
# 구글 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인 세션 쿠키 서명용 임의의 긴 문자열 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# 배포 주소(리디렉션 URI 계산에 사용). Vercel 에는 반드시 지정: https://donb-midterm.vercel.app
# 로컬에서는 비워두면 접속한 주소(http://localhost:3000)에서 자동 계산
APP_URL=

# --- 로컬 개발용 (구글 로그인이 설정되지 않았을 때만 사용되는 비밀번호 로그인) ---
APP_PASSWORD=
